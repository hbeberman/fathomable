// @okf-doc: /decisions/0011-theme-schema.md
// Fathomable built-in dark theme (ADR 0011). The background is left unset so
// transparent terminals show through. Copy this file to
// $XDG_CONFIG_HOME/fathomable/themes/<name>.kdl to make your own; a copy
// may `inherits "default-dark"` and set only the keys it changes.

palette {
    fg       "#d0d0d0"
    dim      "#8a8a8a"
    trim     "#606060"
    surface  "#303030"
    overlay  "#1b222c"
    menu     "overlay"
    overlay-focus "#263342"
    list-active "#26384a"
    list-inactive "#202830"
    list-cursor "#9bc3ed"
    key      "#8faecb"
    select   "#264f78"
    blue     "#7aa6da"
    green    "#b9ca4a"
    yellow   "#ffda03"
    red      "#d54e53"
    purple   "#c397d8"
    teal     "#8abeb7"
    orange   "#e78c45"
}

code {
    syntect "base16-ocean.dark"
}

colors {
    "ui.text"              fg="fg"
    "ui.linenr"            fg="trim"
    "ui.selection"         bg="select"
    "ui.search.match"      fg="black" bg="yellow"
    "ui.statusline"        bg="surface"
    "ui.statusline.normal" fg="black" bg="blue" mods="bold"
    "ui.statusline.select" fg="black" bg="purple" mods="bold"
    "ui.statusline.input"  fg="black" bg="yellow" mods="bold"
    "ui.statusline.info"   fg="dim"
    "ui.warning"           fg="black" bg="red" mods="bold"
    "ui.header"            bg="surface"

    "ui.sidebar"              fg="fg"
    "ui.list.active"       bg="list-active"
    "ui.list.inactive"     bg="list-inactive"
    "ui.list.cursor"       fg="list-cursor"
    "ui.list.hover"        bg="overlay-focus"
    "ui.sidebar.dir"          fg="blue"
    "ui.popup"             fg="fg" bg="overlay"
    "ui.popup.key"         fg="key"
    "ui.menu"              fg="fg" bg="overlay"
    "ui.picker.match"      fg="key"

    "diff.plus"            fg="green"
    "diff.delta"           fg="orange"
    "diff.minus"           fg="red"

    "git.staged"           fg="teal"
    "git.unstaged"         fg="orange"

    "thread.open"          fg="blue"
    "thread.resolved"      fg="bright-black"
    "thread.waiting"       fg="green" mods="bold"
    "thread.focus"         bg="#1c2a3f"
    "thread.bracket"       bg="#4a4420"
    "thread.inline"        bg="#171d27"
    "thread.user"          fg="blue" bg="#1c2738"
    "thread.agent"         fg="green" bg="#1c261e"
    "thread.draft"         bg="#2c2a1f"
    "thread.cursor"        fg="yellow"

    "markup.heading"       fg="purple" mods="bold"
    "markup.raw.inline"    fg="orange"
    "markup.raw.block"     fg="teal"
    "markup.link"          fg="blue" mods="underline"
    "markup.list"          fg="dim"
    "markup.quote"         fg="green" mods="italic"
}
