// @okf-doc: /decisions/0011-theme-schema.md
// Fathomable built-in light theme (ADR 0011). Sets an explicit background so
// it reads correctly on a dark terminal.

palette {
    fg       "#1f1f1f"
    dim      "#6a6a6a"
    trim     "#a0a0a0"
    paper    "#fafafa"
    surface  "#e8e8e8"
    menu     "#e3e9f2"
    select   "#cfe3ff"
    blue     "#1f5fbf"
    green    "#3f7d20"
    yellow   "#ffd633"
    red      "#c0392b"
    purple   "#7d3c98"
    teal     "#1f7a7a"
    orange   "#b35a00"
}

code {
    syntect "base16-ocean.light"
}

colors {
    "ui.text"              fg="fg" bg="paper"
    "ui.linenr"            fg="trim"
    "ui.selection"         bg="select"
    "ui.search.match"      fg="black" bg="yellow"
    "ui.statusline"        bg="surface"
    "ui.statusline.normal" fg="white" bg="blue" mods="bold"
    "ui.statusline.select" fg="white" bg="purple" mods="bold"
    "ui.statusline.input"  fg="black" bg="yellow" mods="bold"
    "ui.statusline.info"   fg="dim"
    "ui.warning"           fg="white" bg="red" mods="bold"
    "ui.header"            bg="surface"

    "ui.sidebar"              fg="fg" bg="paper"
    "ui.sidebar.selected"     bg="surface" mods="bold"
    "ui.sidebar.dir"          fg="blue"
    "ui.popup"             fg="fg" bg="surface"
    "ui.popup.key"         fg="orange" mods="bold"
    "ui.menu"              fg="fg" bg="menu"
    "ui.picker.match"      fg="orange" mods="bold"
    "ui.picker.selected"   bg="select"

    "diff.plus"            fg="green"
    "diff.delta"           fg="orange"
    "diff.minus"           fg="red"

    "git.staged"           fg="teal"
    "git.unstaged"         fg="orange"

    "thread.open"          fg="blue"
    "thread.resolved"      fg="bright-black"
    "thread.waiting"       fg="green" mods="bold"
    "thread.line"          bg="#fff6d6"
    "thread.focus"         bg="#d6f0ef"
    "thread.inline"        bg="#eef2f7"
    "thread.user"          fg="blue" bg="#e3ebf8"
    "thread.agent"         fg="green" bg="#e8f1e6"
    "thread.draft"         bg="#fbf5dc"
    "thread.cursor"        fg="yellow"

    "markup.heading"       fg="purple" mods="bold"
    "markup.raw.inline"    fg="orange"
    "markup.raw.block"     fg="teal"
    "markup.link"          fg="blue" mods="underline"
    "markup.list"          fg="dim"
    "markup.quote"         fg="green" mods="italic"
}
